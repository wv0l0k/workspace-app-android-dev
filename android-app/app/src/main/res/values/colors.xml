    <color name="bg_panel">#212121</color>
    <color name="border">#333333</color>
    <color name="border_soft">#2a2a2a</color>
    <color name="text">#e3e3e3</color>
    <color name="text_muted">#93938f</color>
    <color name="text_faint">#5f5f5c</color>
    <color name="accent">#4a9eff</color>
    <color name="accent_hover">#63acff</color>
    <color name="accent_dim">#2f6fb3</color>
    <color name="danger">#e5686c</color>
    <color name="on_accent">#0f1720</color>

    <!-- The exact blue baked into the logo artwork itself (logo-master.svg's
         background square), used only for the launcher icon's background layer -
         distinct from "accent" above, which is the general app accent color and a
         close but not identical shade. -->
    <color name="ic_launcher_background">#1a86ff</color>
