<resources>
    <string name="app_name">Workspace</string>
    <!-- Doubles as the small subtitle under the "W" logo on the connect
         screen, matching the web login card's "Sign in to your instance". -->
    <string name="settings_title">Connect to your server</string>
    <string name="settings_url_hint">https://workspace.yourdomain.com</string>
    <string name="settings_username_hint">Username</string>
    <string name="settings_password_hint">Password</string>
    <string name="settings_save">Connect and sign in</string>
    <string name="settings_connecting">Connecting…</string>

    <!-- Shown instead of WebView's own bare "Web page not available" browser-chrome
         error page, for when the very first connection to the server fails outright
         (DNS/connection failure - not the same as the small in-app "You're offline"
         banner, which only appears once the app itself has already loaded, from an
         earlier successful visit, and is served from the on-device cache). -->
    <string name="offline_title">Can\'t reach your server</string>
    <string name="offline_message">Check your connection, or that %1$s is reachable, and try again.</string>
    <string name="offline_retry">Retry</string>
</resources>
