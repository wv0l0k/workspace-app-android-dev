<?xml version="1.0" encoding="utf-8"?>
<!--
     Root of MainActivity. The WebView itself is still added here in code (same as
     before - see MainActivity.onCreate), at index 0 so it sits underneath the offline
     overlay below it. The overlay is declared here, GONE by default, and only shown
     by MainActivity when the very first connection to the server fails outright (see
     WebViewClient.onReceivedError) - not shown for the ordinary in-app "You're
     offline" banner, which is part of the web page itself and only ever appears once
     the app has already loaded successfully at least once.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:id="@+id/offlineView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_app"
        android:padding="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Same "card" look as the connect-to-server screen (activity_settings.xml),
             so this doesn't read as a different, jarring app. -->
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/login_card_bg"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="30dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/login_logo_bg"
                android:gravity="center"
                android:text="W"
                android:textColor="@color/on_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/offline_title"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/offlineMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp"
                android:gravity="center_horizontal"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/offlineRetryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_bg"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:text="@string/offline_retry"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
